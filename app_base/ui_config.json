      "breadcrumbs": "HOME  /  RENTABILIDAD",
      "kpis": [
        {
          "icono": "account_balance",
          "label": "Utilidad Total",
          "sql": "SELECT SUM(Profit) AS v FROM superstore",
          "formato": "money",
          "color": "#0e7a5f",
          "sub_label": "Ganancia neta acumulada"
        },
        {
          "icono": "insights",
