        },
        {
          "icono": "local_shipping",
          "label": "Envío Estándar",
          "sql": "SELECT ROUND(SUM(CASE WHEN \"Ship Mode\" = 'Standard Class' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 1) AS v FROM superstore",
