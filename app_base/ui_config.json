        }
      ],
      "graficos": [
        {
          "tipo": "bar",
          "titulo": "Utilidad por Sub-Categoría",
          "sub": "Rentabilidad detallada (incluye pérdidas)",
          "icono": "bar_chart",
          "sql": "SELECT \"Sub-Category\" AS SubCategoria, SUM(Profit) AS Utilidad FROM superstore GROUP BY SubCategoria ORDER BY Utilidad DESC",
          "x": "SubCategoria",
          "y": "Utilidad",
          "alto": 380,
          "col_izq": 7
        },
        {
          "tipo": "line",
          "titulo": "Tendencia Mensual de Utilidad",
          "sub": "Evolución de ganancia neta por mes",
          "icono": "show_chart",
          "sql": "SELECT date_trunc('month', \"Order Date\") AS Mes, SUM(Profit) AS Utilidad FROM superstore GROUP BY Mes ORDER BY Mes",
          "x": "Mes",
          "y": "Utilidad",
          "alto": 380,
          "col_izq": 5
        },
        {
          "tipo": "scatter",
          "titulo": "Descuento vs Utilidad",
          "sub": "Impacto del descuento sobre la ganancia (por línea)",
          "icono": "scatter_plot",
          "sql": "SELECT Discount, Profit, Category FROM superstore",
          "x": "Discount",
          "y": "Profit",
          "color": "Category",
          "alto": 380
        },
        {
          "tipo": "bar_grouped",
          "titulo": "Utilidad por Categoría y Año",
          "sub": "Comparativo anual por categoría",
          "icono": "stacked_bar_chart",
          "sql": "SELECT CAST(year(\"Order Date\") AS VARCHAR) AS Año, Category, SUM(Profit) AS Utilidad FROM superstore GROUP BY Año, Category ORDER BY Año",
