          "y": "Ventas",
          "alto": 420,
          "col_izq": 7
        },
        {
          "tipo": "bar_stacked",
          "titulo": "Ventas por Región y Segmento",
          "sub": "Composición segmentada por territorio",
          "icono": "stacked_bar_chart",
          "sql": "SELECT Region, Segment, SUM(Sales) AS Ventas FROM superstore GROUP BY Region, Segment",
          "x": "Region",
          "y": "Ventas",
          "stack_by": "Segment",
          "alto": 420,
          "col_izq": 5
        },
        {
          "tipo": "bar",
          "titulo": "Ventas por Modo de Envío",
          "sub": "Preferencia logística del cliente",
          "icono": "local_shipping",
          "sql": "SELECT \"Ship Mode\" AS Envio, SUM(Sales) AS Ventas FROM superstore GROUP BY Envio ORDER BY Ventas DESC",
          "x": "Envio",
          "y": "Ventas",
          "alto": 320
        }
      ],
      "tablas": [
        {
          "titulo": "Top 10 Ciudades por Ventas",
          "sub": "Mercados urbanos con mayor facturación",
          "icono": "location_city",
          "sql": "SELECT City AS Ciudad, \"State/Province\" AS Estado, SUM(Sales) AS Ventas, SUM(Profit) AS Utilidad FROM superstore GROUP BY 1, 2 ORDER BY Ventas DESC",
          "limite": 10
        }
      ]
    },
    {
      "id": "profitability",
