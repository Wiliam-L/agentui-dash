  "modulos": [
    {
      "id": "overview",
      "nombre": "Resumen Ejecutivo",
      "icono": "📊",
      "descripcion": "Indicadores clave y desempeño global del negocio",
      "material_icon": "dashboard",
      "breadcrumbs": "HOME  /  RESUMEN EJECUTIVO",
      "kpis": [
        {
          "icono": "payments",
          "label": "Ventas Totales",
          "sql": "SELECT SUM(Sales) AS v FROM superstore",
          "formato": "money",
          "color": "#0f3a5f",
          "sub_label": "Ingresos acumulados"
        },
        {
          "icono": "trending_up",
          "label": "Utilidad Total",
          "sql": "SELECT SUM(Profit) AS v FROM superstore",
          "formato": "money",
          "color": "#0e7a5f",
          "sub_label": "Ganancia neta"
        },
        {
          "icono": "insights",
          "label": "Margen de Utilidad",
          "sql": "SELECT ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS v FROM superstore",
          "formato": "float",
          "color": "#246bfd",
          "sub_label": "% sobre ventas",
          "sub_suffix": " %"
        },
        {
          "icono": "receipt_long",
          "label": "Pedidos",
          "sql": "SELECT COUNT(DISTINCT \"Order ID\") AS v FROM superstore",
          "formato": "int",
          "color": "#7c3aed",
          "sub_label": "Órdenes únicas"
        },
        {
          "icono": "inventory_2",
          "label": "Unidades Vendidas",
          "sql": "SELECT SUM(Quantity) AS v FROM superstore",
          "formato": "int",
          "color": "#c2410c",
          "sub_label": "Cantidad total"
        },
        {
          "icono": "percent",
          "label": "Descuento Promedio",
          "sql": "SELECT ROUND(AVG(Discount) * 100, 2) AS v FROM superstore",
          "formato": "float",
          "color": "#b45309",
          "sub_label": "% de descuento medio",
          "sub_suffix": " %"
        }
      ],
      "graficos": [
        {
          "tipo": "line",
          "titulo": "Tendencia Mensual de Ventas",
          "sub": "Evolución de ingresos por mes",
          "icono": "show_chart",
          "sql": "SELECT date_trunc('month', \"Order Date\") AS Mes, SUM(Sales) AS Ventas FROM superstore GROUP BY Mes ORDER BY Mes",
          "x": "Mes",
          "y": "Ventas",
          "alto": 340,
          "col_izq": 7
        },
        {
          "tipo": "pie",
          "titulo": "Ventas por Segmento",
          "sub": "Participación por tipo de cliente",
          "icono": "donut_small",
          "sql": "SELECT Segment, SUM(Sales) AS Ventas FROM superstore GROUP BY Segment ORDER BY Ventas DESC",
          "columna": "Segment",
          "valores": "Ventas",
          "alto": 340,
          "col_izq": 5
        },
        {
          "tipo": "bar",
          "titulo": "Ventas por Categoría",
          "sub": "Comparativo de categorías de producto",
          "icono": "bar_chart",
          "sql": "SELECT Category, SUM(Sales) AS Ventas FROM superstore GROUP BY Category ORDER BY Ventas DESC",
          "x": "Category",
          "y": "Ventas",
          "alto": 320,
          "col_izq": 6
        },
        {
          "tipo": "bar",
          "titulo": "Ventas por Región",
          "sub": "Desempeño territorial",
          "icono": "public",
          "sql": "SELECT Region, SUM(Sales) AS Ventas FROM superstore GROUP BY Region ORDER BY Ventas DESC",
          "x": "Region",
          "y": "Ventas",
          "alto": 320,
          "col_izq": 6
        }
      ]
    },
    {
      "id": "products",
      "nombre": "Productos",
      "icono": "📦",
      "descripcion": "Análisis de catálogo, sub-categorías y productos estrella",
      "material_icon": "inventory_2",
      "breadcrumbs": "HOME  /  PRODUCTOS",
      "kpis": [
        {
          "icono": "category",
          "label": "Productos Únicos",
          "sql": "SELECT COUNT(DISTINCT \"Product ID\") AS v FROM superstore",
          "formato": "int",
          "color": "#0f3a5f",
          "sub_label": "SKU en catálogo"
        },
        {
          "icono": "workspace_premium",
          "label": "Mejor Categoría",
          "sql": "SELECT Category AS v FROM superstore GROUP BY Category ORDER BY SUM(Sales) DESC LIMIT 1",
          "formato": "str",
          "color": "#0e7a5f",
          "sub_label": "Mayor venta acumulada"
        },
        {
          "icono": "shopping_cart",
          "label": "Ticket Promedio",
          "sql": "SELECT SUM(Sales) / COUNT(DISTINCT \"Order ID\") AS v FROM superstore",
          "formato": "money",
          "color": "#246bfd",
          "sub_label": "Venta por pedido"
        },
        {
          "icono": "warning",
          "label": "Líneas con Pérdida",
          "sql": "SELECT SUM(CASE WHEN Profit < 0 THEN 1 ELSE 0 END) AS v FROM superstore",
          "formato": "int",
          "color": "#b91c1c",
          "sub_label": "Transacciones a pérdida"
        }
      ],
      "graficos": [
        {
          "tipo": "bar_h",
          "titulo": "Ventas por Sub-Categoría",
          "sub": "Ranking horizontal de sub-categorías",
          "icono": "leaderboard",
          "sql": "SELECT \"Sub-Category\" AS SubCategoria, SUM(Sales) AS Ventas FROM superstore GROUP BY SubCategoria ORDER BY Ventas DESC",
          "x": "SubCategoria",
          "y": "Ventas",
          "alto": 460,
          "col_izq": 7
        },
        {
          "tipo": "pie",
          "titulo": "Utilidad por Categoría",
          "sub": "Distribución de ganancia por categoría",
          "icono": "donut_small",
          "sql": "SELECT Category, SUM(Profit) AS Utilidad FROM superstore GROUP BY Category ORDER BY Utilidad DESC",
          "columna": "Category",
          "valores": "Utilidad",
          "alto": 460,
          "col_izq": 5
        },
        {
          "tipo": "heatmap",
          "titulo": "Ventas: Categoría × Región",
          "sub": "Mapa de calor de ingresos",
          "icono": "grid_view",
          "sql": "SELECT Category, Region, SUM(Sales) AS Ventas FROM superstore GROUP BY Category, Region",
          "x": "Category",
          "y": "Region",
          "valores": "Ventas",
          "alto": 340
        }
      ],
      "tablas": [
        {
          "titulo": "Top 10 Productos por Ventas",
          "sub": "Los productos con mayor facturación",
          "icono": "emoji_events",
          "sql": "SELECT \"Product Name\" AS Producto, Category AS Categoría, SUM(Sales) AS Ventas, SUM(Profit) AS Utilidad, SUM(Quantity) AS Unidades FROM superstore GROUP BY 1, 2 ORDER BY Ventas DESC",
          "limite": 10
        }
      ]
    },
    {
      "id": "geography",
