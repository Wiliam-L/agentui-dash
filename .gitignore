# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# Environment files
.env
.env.*

# Virtual environments
.venv/
venv/
env/

# DuckDB
*.duckdb
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Streamlit
# The theme config is required at runtime: without it the BaseWeb widgets
# (multiselect, file uploader) fall back to the dark palette and render black.
.streamlit/*
!.streamlit/config.toml
app_base/.streamlit/*
!app_base/.streamlit/config.toml

# Logs
*.log

# OS/Editor temp files
*.tmp
*.temp

# Junie session artifacts
.junie/

# Local session artifacts
compact.md
compact-persist.log
.playwright-mcp/

# Screenshots and images
screenshots/
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Fonts and large binaries
*.ttf
*.otf

# uv lock files
uv.lock

# Uploaded data and manifests
data_uploaded/

# Large CSV data files (sample data for testing, not source code)
*.csv

# Config backups created by tools.py
*.json.bak

# LLM session logs
LOGS_LLM.MD

# Task/feature docs (not for repo)
task.md
requirements.md
feature.md
FEATURE.md
